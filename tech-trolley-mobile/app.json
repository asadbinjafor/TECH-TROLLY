{
  "expo": {
    "name": "Tech Trolley",
    "slug": "tech-trolley",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "techtrolley",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.techtrolley.shop",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.techtrolley.shop",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#222529"
      },
      "permissions": [],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-font",
        {
          "fonts": ["./assets/NotoSansBengali.ttf"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#222529"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "apiUrlConfigured": false
    },
    "platforms": ["ios", "android"]
  }
}
