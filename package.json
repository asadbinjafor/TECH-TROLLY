{
  "name": "tech-trolley-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "tech-trolley-backend",
    "tech-trolley-frontend",
    "tech-trolley-mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:shared": "npm run build --workspaces --if-present --include-workspace-root=false -w @tech-trolley/contracts -w @tech-trolley/i18n -w @tech-trolley/design-tokens -w @tech-trolley/api-client -w @tech-trolley/invoice",
    "build": "npm run build:shared && npm run build -w @tech-trolley/backend && npm run build -w @tech-trolley/frontend",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build:shared && npm test -w @tech-trolley/backend",
    "db:migrate": "npm run migrate -w @tech-trolley/backend",
    "db:bootstrap": "npm run bootstrap -w @tech-trolley/backend",
    "build:api": "npm run build --workspace @tech-trolley/contracts && npm run build --workspace @tech-trolley/i18n && npm run build --workspace @tech-trolley/backend",
    "build:web": "npm run build:shared && npm run build --workspace @tech-trolley/frontend",
    "release:api": "node scripts/release-api.mjs",
    "start:render": "node scripts/start-render.mjs",
    "test:hosting": "tsx --test tech-trolley-frontend/test/*.test.ts tech-trolley-backend/test/hosting.test.ts scripts/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    }
  }
}
