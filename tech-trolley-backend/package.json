    "@sparticuz/chromium": "153.0.0",
    "@tech-trolley/contracts": "1.0.0",
    "@tech-trolley/i18n": "^1.0.0",
    "@tech-trolley/invoice": "1.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "js-yaml": "^5.5.0",
    "multer": "^2.5.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.22.0",
    "puppeteer-core": "25.16.0",
    "reflect-metadata": "^0.2.2",
