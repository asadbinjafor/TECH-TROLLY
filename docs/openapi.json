    "/commands/opening": {
      "post": {
        "summary": "Post opening atomically",
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "cash": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,2})?$"
                  },
                  "bank": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,2})?$"
                  }
                },
                "required": [
                  "cash",
                  "bank"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Committed authoritative document"
          },
          "409": {
            "description": "Stock, balance, due or idempotency conflict"
          }
        }
      }
    },
    "/commands/purchase": {
      "post": {
        "summary": "Post purchase atomically",
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  "brand": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  "variant": {
                    "default": "",
                    "type": "string",
                    "maxLength": 120
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "phone",
                      "accessory"
                    ]
                  },
                  "condition": {
                    "type": "string",
                    "enum": [
                      "new",
                      "used",
                      "refurbished"
                    ]
                  },
                  "imei": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{15}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "battery": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "box": {
                    "default": "unspecified",
                    "type": "string",
                    "enum": [
                      "with",
                      "without",
                      "unspecified"
                    ]
                  },
                  "supplierId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "cost": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,2})?$"
                  },
                  "procurement": {
                    "default": "0",
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,2})?$"
                  },
                  "treatment": {
                    "type": "string",
                    "enum": [
                      "capitalize",
                      "expense"
                    ]
                  },
                  "paid": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,2})?$"
                  },
                  "account": {
                    "type": "string",
                    "enum": [
                      "cash",
                      "bank"
                    ]
                  },
                  "note": {
                    "default": "",
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": [
                  "model",
                  "brand",
                  "variant",
                  "category",
                  "condition",
                  "imei",
                  "battery",
                  "box",
                  "supplierId",
                  "cost",
                  "procurement",
                  "treatment",
                  "paid",
                  "account",
                  "note"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Committed authoritative document"
          },
          "409": {
            "description": "Stock, balance, due or idempotency conflict"
          }
        }
      }
    },
